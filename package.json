{
  "name": "strata-procedural",
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "description": "Seeded procedural layers, terrain, surface fields and material bakes with optional Three.js adapters",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./noise": { "types": "./dist/noise.d.ts", "import": "./dist/noise.js" },
    "./sdf": { "types": "./dist/sdf.d.ts", "import": "./dist/sdf.js" },
    "./terrain": { "types": "./dist/terrain.d.ts", "import": "./dist/terrain.js" },
    "./materials": { "types": "./dist/materials.d.ts", "import": "./dist/materials.js" },
    "./mesh": { "types": "./dist/mesh.d.ts", "import": "./dist/mesh.js" },
    "./shaders": { "types": "./dist/shaders.d.ts", "import": "./dist/shaders.js" },
    "./surface-fields": { "types": "./dist/surface-fields.d.ts", "import": "./dist/surface-fields.js" },
    "./three": { "types": "./dist/three.d.ts", "import": "./dist/three.js" },
    "./r3f": { "types": "./dist/r3f.d.ts", "import": "./dist/r3f.js" }
  },
  "files": ["dist", "docs", "README.md", "LICENSE", "CHANGELOG.md", "llms.txt", "context7.json"],
  "scripts": {
    "demo": "node examples/server.mjs",
    "test:visual": "playwright test --config tests/playwright.gallery.config.ts",
    "build": "tsup",
    "lint": "biome lint src/ tests/ scripts/",
    "package:check": "pnpm exec publint && pnpm exec attw --pack --profile esm-only && node scripts/verify-package.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gpu": "playwright test --config tests/playwright.gpu.config.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text && node scripts/normalize-lcov.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run package:check"
  },
  "keywords": ["procedural-generation", "seeded", "layers", "terrain", "surface-fields", "materials", "bake", "three", "typescript"],
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jbcom/strata-procedural.git" },
  "homepage": "https://github.com/jbcom/strata-procedural#readme",
  "bugs": { "url": "https://github.com/jbcom/strata-procedural/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "three": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": { "optional": true },
    "react": { "optional": true },
    "three": { "optional": true }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@playwright/test": "^1.63.0",
    "@biomejs/biome": "^2.5.15",
    "@react-three/fiber": "^9.8.1",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.17",
    "react": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "three": "^0.186.1",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
